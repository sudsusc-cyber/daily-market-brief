{#-
  email.html.j2 — 每日晨报 HTML 邮件模板

  设计基调:Berkshire 致股东信 × FT Weekend × Howard Marks Memo
  强调色:oxblood #7A1F2B(全文唯一)
  字体:衬线为主,中英文 fallback 链覆盖 macOS / Windows / Linux

  M2 阶段渲染:masthead + I. 持仓信号 + footer
  M3 起按 {% if section %} 渐次启用其他区块

  上下文变量:
    signals       — list[StockSignal](M2 必传)
    generated_at  — datetime,北京时间
    sentiment     — dict | None       (M3 用)
    company_news  — str  | None       (M3 用)
    figures       — list | None       (M3 用)
    macro_news    — str  | None       (M3 用)

  Filter(由 renderer/render.py 注册):
    | price  →  浮点千分位 + 2 位小数
    | pct    →  浮点百分比,带正负号(如 +9.2%)
-#}
{%- set year_cn = (generated_at.year | string)
      | replace('0','〇') | replace('1','一') | replace('2','二')
      | replace('3','三') | replace('4','四') | replace('5','五')
      | replace('6','六') | replace('7','七') | replace('8','八')
      | replace('9','九') -%}
{# 月、日转汉字数字:1-31 → 一/二/三/.../十/十一/.../三十一 #}
{%- set _digit_cn = ['零','一','二','三','四','五','六','七','八','九','十'] -%}
{%- macro num_cn(n) -%}
{%- if n <= 10 -%}{{ _digit_cn[n] }}
{%- elif n < 20 -%}十{{ _digit_cn[n - 10] }}
{%- elif n % 10 == 0 -%}{{ _digit_cn[n // 10] }}十
{%- else -%}{{ _digit_cn[n // 10] }}十{{ _digit_cn[n % 10] }}
{%- endif -%}
{%- endmacro -%}
{%- set month_cn = num_cn(generated_at.month) -%}
{%- set day_cn = num_cn(generated_at.day) -%}
{%- set weekdays = ['星期一', '星期二', '星期三', '星期四', '星期五', '星期六', '星期日'] -%}
{# 字体链由 render.py 的共享排版契约传入：西文/数字使用齐高衬线体，中文回落宋体。 #}
{%- set color_paper = '#F8F5EE' -%}
{%- set color_paper_alt = '#F2ECDC' -%}
{%- set color_ink = '#1A1A1A' -%}
{%- set color_ink_soft = '#2B2B2B' -%}
{%- set color_muted = '#6B6B6B' -%}
{%- set color_faint = '#6F685C' -%}
{%- set color_rule = '#1A1A1A' -%}
{%- set color_hairline = '#D9D2BE' -%}
{%- set color_accent = '#7A1F2B' -%}
{%- set color_lab_pinned = '#A07735' -%}{# Frontier Labs 头排品牌色，仅 OpenAI / Anthropic；新增 lab 默认走 color_ink #}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
{# 移动端按 640px 正文 + 左右各 16px 页边距的桌面画布整体缩放；不做窄屏重排。 #}
<meta name="viewport" content="width=672" />
<meta name="x-apple-disable-message-reformatting" />
<meta name="color-scheme" content="light" />
<meta name="supported-color-schemes" content="light" />
<title>朝闻录 · {{ year_cn }}年 · {{ month_cn }}月{{ day_cn }}日</title>
<style type="text/css">
  /* 邮件客户端安全降级：基础样式始终是完整胶囊；支持裁切的移动端/WebView
     再启用透明玻璃尖角。忽略 @supports 的客户端仍得到不溢出的完整色带。 */
  @supports ((clip-path:polygon(0 0,100% 50%,0 100%)) or (-webkit-clip-path:polygon(0 0,100% 50%,0 100%))) {
    .sentiment-glass-tube { border-radius:999px 0 0 999px !important; }
  }
</style>
<!--[if mso]>
<style type="text/css">
  table,td,div,h1,h2,p { font-family: Cambria, Georgia, serif !important; }
  table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
</style>
<![endif]-->
</head>
<body style="margin:0; padding:0; background-color:{{ color_paper }}; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">

{# 收件箱预览文字(preheader),不可见 #}
<div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:{{ color_paper }};">
  {{ year_cn }}年 · {{ month_cn }}月{{ day_cn }}日 · 持仓信号摘录 · 数据截至北京时间 {{ generated_at.strftime('%H:%M') }}
</div>
<div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:{{ color_paper }};">
  &#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{ color_paper }};">
  <tr>
    <td class="email-shell" align="center" style="padding:{% if header_image_url %}16px{% else %}48px{% endif %} 16px 56px 16px;">

      {# 所有客户端共用同一张 640px 桌面画布。移动端通过 672px viewport
         将正文与左右页边距整体缩放，保留桌面端的栏宽、字号比例和章节位置。 #}
      <!--[if mso]>
      <table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0"><tr><td>
      <![endif]-->
      <table class="email-container" data-email-layout="fixed-desktop" role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="background-color:{{ color_paper }}; width:640px; min-width:640px; max-width:640px; font-family:{{ serif_body }}; {{ numeric_features }}">

        {# ──────────────────────────  刊头图  ─────────────────────────── #}
        {%- if header_image_url %}
        <tr>
          <td style="padding:0; line-height:0; font-size:0; border-bottom:2px solid {{ color_accent }};">
            <img src="{{ header_image_url }}"
                 width="640"
                 alt="刊头图"
                 style="display:block; width:640px; min-width:640px; max-width:640px; height:auto; border:0; line-height:0; -ms-interpolation-mode:bicubic;" />
          </td>
        </tr>
        {%- endif %}

        {# ─────────────────────────  MASTHEAD  ───────────────────────── #}
        <tr>
          <td align="center" style="padding:{% if header_image_url %}28px{% else %}0{% endif %} 24px 4px 24px; font-family:{{ serif_display }}; color:{{ color_ink }}; text-align:center;">
            {# QQ 邮箱网页版兼容性:把每个文字块用 <table align="center"> 包装 — HTML
               表格 align 属性是邮件客户端最兼容的居中方式,优于 inline-block + CSS。 #}
            {# text-indent = letter-spacing/2:抵消 QQ 邮箱网页版"尾部 letter-spacing 不参与
               居中"的渲染偏移(末字符后的字距让文字看起来偏左半个字距,需把整段右推抵消) #}
            <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 18px auto;"><tr><td style="font-size:11px; line-height:1.4; letter-spacing:0.46em; text-indent:0.46em; color:{{ color_accent }}; text-transform:uppercase; font-family:{{ serif_body }};">Morning&nbsp;&nbsp;Journal</td></tr></table>
            <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;"><tr><td style="font-size:42px; line-height:1.0; font-weight:500; letter-spacing:0.35em; text-indent:0.35em; color:{{ color_ink }}; font-family:{{ serif_display }};">朝闻录</td></tr></table>
            <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:18px auto 14px auto;"><tr><td style="height:1px; line-height:1px; font-size:0; width:48px; background-color:{{ color_accent }};">&nbsp;</td></tr></table>
            <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;"><tr><td style="font-size:13px; line-height:1.4; letter-spacing:0.10em; text-indent:0.10em; color:{{ color_muted }}; font-family:{{ serif_body }};">{{ year_cn }}年 · {{ month_cn }}月{{ day_cn }}日 · {{ weekdays[generated_at.weekday()] }}</td></tr></table>
          </td>
        </tr>

        {# 装饰性分隔(章节起始) #}
        <tr>
          <td align="center" style="padding:36px 24px 36px 24px; text-align:center;">
            <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
              <tr>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
                <td style="padding:0 14px; font-size:14px; color:{{ color_accent }}; line-height:1; font-family:{{ serif_display }};">·&nbsp;·&nbsp;·</td>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>

        {# ─────────────────────────  I. 持仓信号  ───────────────────────── #}
        {% if signals %}
        <tr>
          <td style="padding:0 24px 0 24px;">

            {# 区段标题:无罗马数字,中文用 letter-spacing 拉字距 #}
            <div style="font-family:{{ serif_display }}; font-size:18px; font-weight:600; color:{{ color_ink }}; letter-spacing:0.4em; line-height:1.2; margin:0; padding:0;">持仓信号</div>
            <div style="font-family:{{ serif_body }}; font-size:11px; color:{{ color_muted }}; letter-spacing:0.3em; text-transform:uppercase; margin:8px 0 0 0;">Position Signals</div>
            <div style="border-top:1px solid {{ color_rule }}; margin-top:24px; line-height:0; font-size:0;">&nbsp;</div>

            {# 引言段:解释这个表格在看什么。M2 实用,M3 起可换成更克制的款式 #}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="padding:18px 4px 8px 4px; font-family:{{ serif_body }}; font-size:16px; line-height:1.9; color:{{ color_ink_soft }}; letter-spacing:0.02em;">
                  {%- if holdings_intro %}
                  {{ holdings_intro }}
                  {%- else %}
                  当前持仓{{ holdings_counts.total }}只——美股{{ holdings_counts.us }}只,港股{{ holdings_counts.hk }}只。下表展示各只标的现价相对 120 周与 200 周均线的位置。
                  现价跌破<span style="color:{{ color_accent }}; font-family:{{ serif_body }}; letter-spacing:0.04em; white-space:nowrap;">120 周</span>触发<span style="color:{{ color_accent }}; letter-spacing:0.16em; text-transform:uppercase; font-weight:600; white-space:nowrap;">&nbsp;DCA</span>,
                  跌破<span style="color:{{ color_accent }}; font-family:{{ serif_body }}; letter-spacing:0.04em; white-space:nowrap;">200 周</span>触发<span style="color:{{ color_accent }}; letter-spacing:0.16em; text-transform:uppercase; font-weight:600; white-space:nowrap;">&nbsp;Lump-sum</span>;
                  无信号则记录至最近均线的距离。
                  {%- endif %}
                </td>
              </tr>
            </table>

          </td>
        </tr>

        {# 数据表格

           不能设置 590px 硬宽度：iOS QQ 邮箱会据此把整封邮件缩成桌面比例。
           百分比列宽按旧版 170/88/104/104/124 的比例换算，桌面观感不变；
           table-layout:fixed 防止 Android QQ 把 ticker 列挤成单字符宽。 #}
        <tr>
          <td class="holdings-wrap" style="padding:8px 24px 8px 24px;">
            {%- set show_valuations = valuations and (valuations | length > 0) -%}
            <table class="holdings-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; width:100%; max-width:590px; table-layout:fixed; font-family:{{ serif_body }}; color:{{ color_ink }}; {{ numeric_features }}">
              <colgroup>
                {% if show_valuations %}
                <col style="width:30%;" />
                <col style="width:13%;" />
                <col style="width:22%;" />
                <col style="width:19%;" />
                <col style="width:16%;" />
                {% else %}
                <col style="width:36%;" />
                <col style="width:16%;" />
                <col style="width:27%;" />
                <col style="width:21%;" />
                {% endif %}
              </colgroup>
              <thead>
                <tr>
                  {# 表头第一栏与 ticker 行结构对齐:logo 子列留空,"标 的"对齐 ticker 文字列 #}
                  <th style="padding:14px 8px 8px 0; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td class="holding-logo-cell" valign="middle" width="36" style="padding-right:12px;">&nbsp;</td>
                        <td valign="middle" align="left" style="font-size:9.5px; font-weight:500; letter-spacing:0.32em; color:{{ color_muted }}; text-transform:uppercase; line-height:1;">
                          标&nbsp;的
                        </td>
                      </tr>
                    </table>
                  </th>
                  <th class="holding-head" align="right" style="padding:14px 0 8px 0; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    现&nbsp;价
                  </th>
                  <th class="holding-head" align="right" style="padding:14px 0 8px {{ 8 if show_valuations else 16 }}px; font-size:9.5px; font-weight:500; letter-spacing:0.12em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }}; white-space:nowrap;">
                    120&nbsp;/&nbsp;200&nbsp;<span style="letter-spacing:0;">周</span>
                  </th>
                  {% if show_valuations %}
                  <th class="holding-head" align="right" style="padding:14px 0 8px 10px; font-size:9.5px; font-weight:500; letter-spacing:0.20em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    内在价<span style="letter-spacing:0;">值</span>
                  </th>
                  {% endif %}
                  <th class="holding-head" align="right" style="padding:14px 0 8px 12px; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    信&nbsp;号
                  </th>
                </tr>
              </thead>
              <tbody>
                {% for s in signals %}
                {%- set is_lump = (s.signal == 'LUMP_SUM') -%}
                {%- set is_dca  = (s.signal == 'DCA') -%}
                {%- set has_error = (s.error is not none) -%}
                {%- set valuation = valuations.get(s.holding.ticker) if show_valuations else none -%}
                {%- set row_bg = color_paper_alt if is_lump else color_paper -%}
                {%- set has_logo = logo_cids and (s.holding.ticker in logo_cids) -%}
                <tr bgcolor="{{ row_bg }}" style="background-color:{{ row_bg }};">
                  {# 标的:logo + ticker / name 横排 #}
                  <td valign="top" style="padding:16px 8px 16px 0; border-bottom:1px solid {{ color_hairline }};">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td class="holding-logo-cell" valign="middle" width="36" style="padding-right:12px;">
                          {% if has_logo %}
                          <img class="holding-logo" src="cid:{{ logo_cids[s.holding.ticker] }}" width="28" height="28" alt="" style="display:block; width:28px; height:28px; border:0; outline:none; border-radius:4px;" />
                          {% else %}
                          <div class="holding-logo-fallback" style="display:block; width:28px; height:28px; line-height:28px; text-align:center; font-size:9px; font-weight:600; letter-spacing:0.08em; color:{{ color_paper }}; background-color:{{ color_ink }}; border-radius:4px;">{{ s.holding.ticker[:3] }}</div>
                          {% endif %}
                        </td>
                        <td valign="middle">
                          {# Android QQ 邮箱按 device-width 直接 reflow(不像 iOS 缩整页),
                             右侧 4 列都 nowrap 时,布局算法会把这一列压到单字符宽,
                             导致 MSFT / Apple 等被切成 M-S-F-T 竖排。强制 nowrap 后
                             表格在窄屏可能横滑或自动缩字号,但好过一字一行。 #}
                          <div class="holding-ticker" style="font-size:15px; font-weight:500; color:{{ color_ink }}; letter-spacing:0.04em; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ s.holding.ticker }}</div>
                          <div class="holding-name" style="font-size:11px; color:{{ color_muted }}; margin-top:3px; line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ s.holding.name }}</div>
                        </td>
                      </tr>
                    </table>
                  </td>

                  {% if has_error %}
                  {# 整行错误态:跨剩余列展示原因 #}
                  <td colspan="{{ 4 if show_valuations else 3 }}" align="right" valign="middle" style="padding:18px 0; border-bottom:1px solid {{ color_hairline }}; font-size:11.5px; color:{{ color_muted }}; font-style:italic; line-height:1.5;">
                    数据获取失败 · {{ s.error }}
                  </td>
                  {% else %}
                  {# 现价 — tabular-nums 让小数点跨行对齐 #}
                  <td class="holding-price" valign="top" align="right" style="padding:18px 0 18px 0; border-bottom:1px solid {{ color_hairline }}; font-size:17px; font-weight:500; color:{{ color_ink }}; letter-spacing:0; line-height:1.1; white-space:nowrap; overflow:hidden;">
                    {{ s.last_close | price }}
                  </td>
                  {# 120/200 周合并：减少一列，给 logo、名称与估值留出稳定宽度。 #}
                  <td class="holding-average" valign="top" align="right" style="padding:18px 0 18px {{ 8 if show_valuations else 16 }}px; border-bottom:1px solid {{ color_hairline }}; white-space:nowrap; overflow:hidden;">
                    <div class="holding-average-main" style="font-size:12.5px; color:{{ color_ink }}; line-height:1.1; white-space:nowrap;">{{ s.sma_120 | price }}<span style="color:{{ color_faint }}; padding:0 3px;">/</span>{{ s.sma_200 | price }}</div>
                    <div class="holding-average-delta" style="font-size:9.5px; color:{{ color_muted }}; margin-top:4px; line-height:1; letter-spacing:0; white-space:nowrap;">{{ s.delta_120 | pct }}<span style="color:{{ color_faint }}; padding:0 3px;">/</span>{{ s.delta_200 | pct }}</div>
                  </td>
                  {% if show_valuations %}
                  <td class="holding-valuation" valign="top" align="right" style="padding:18px 0 18px 10px; border-bottom:1px solid {{ color_hairline }}; white-space:nowrap; overflow:hidden;">
                    {% if valuation and valuation.intrinsic_value is not none %}
                    <div class="holding-valuation-main" style="font-size:13.5px; font-weight:500; color:{{ color_ink }}; line-height:1.1; white-space:nowrap;">{{ valuation.intrinsic_value | price }}</div>
                      {% if valuation.implied_return is not none %}
                    <div class="holding-implied-return" style="font-size:8.5px; color:{{ color_accent if valuation.is_attractive else color_muted }}; margin-top:4px; line-height:1.1; letter-spacing:0.08em; white-space:nowrap;">{{ valuation.return_label }}&nbsp;{{ valuation.implied_return | rate }}</div>
                      {% else %}
                    <div class="holding-implied-return" style="font-size:8.5px; color:{{ color_muted }}; margin-top:4px; line-height:1.1; letter-spacing:0.08em; white-space:nowrap;">{{ valuation.return_label }}&nbsp;待更新</div>
                      {% endif %}
                    {% else %}
                    <div class="holding-valuation-pending" style="font-size:10.5px; color:{{ color_muted }}; line-height:1.35; white-space:nowrap;">待更新</div>
                    {% endif %}
                  </td>
                  {% endif %}
                  {# 信号 #}
                  <td class="holding-signal" valign="middle" align="right" style="padding:18px 0 18px 12px; border-bottom:1px solid {{ color_hairline }}; white-space:nowrap; overflow:hidden;">
                    {% if is_lump %}
                      <span class="holding-signal-badge" style="display:inline-block; padding:5px 6px 5px 6px; background-color:{{ color_accent }}; color:{{ color_paper }}; font-size:8.5px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; line-height:1.3; mso-line-height-rule:exactly; white-space:nowrap;">Lump-sum</span>
                    {% elif is_dca %}
                      <span class="holding-signal-badge" style="display:inline-block; font-size:11.5px; font-weight:600; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_accent }}; line-height:1; padding:0; border-bottom:1px solid {{ color_accent }}; padding-bottom:3px; white-space:nowrap;">DCA</span>
                    {% else %}
                      <span style="font-size:15px; color:{{ color_faint }}; line-height:1;">—</span>
                    {% endif %}
                  </td>
                  {% endif %}
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </td>
        </tr>

        {# 表格脚注 #}
        <tr>
          <td style="padding:14px 24px 0 24px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="font-family:{{ serif_body }}; font-size:10.5px; color:{{ color_muted }}; line-height:1.7; letter-spacing:0.02em;">
                  数据源&nbsp;Yahoo&nbsp;Finance&nbsp;周频收盘价。120 / 200 周已合并显示，均为对应周频收盘均价的算术平均。
                  括号内百分比表示现价相对该均线的位置——负值即现价低于均线。
