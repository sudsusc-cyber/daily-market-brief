                  <table class="sentiment-glass-tube" data-sentiment-glass-tube="true" data-sentiment-glass-style="quiet-capsule" data-sentiment-glass-tip="curved-clear" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                         style="width:100%; max-width:100%; table-layout:fixed; border-collapse:separate; border-spacing:0; background-color:#F3F0EA; background-color:rgba(248,245,238,0.42); background-image:linear-gradient(180deg,rgba(255,255,255,0.82) 0%,rgba(255,255,255,0.22) 46%,rgba(26,26,26,0.05) 100%); border:1px solid #C8C1B5; border-radius:999px; -webkit-clip-path:polygon(0 0,calc(100% - 12px) 0,calc(100% - 6px) 12%,calc(100% - 2px) 32%,100% 50%,calc(100% - 2px) 68%,calc(100% - 6px) 88%,calc(100% - 12px) 100%,0 100%); clip-path:polygon(0 0,calc(100% - 12px) 0,calc(100% - 6px) 12%,calc(100% - 2px) 32%,100% 50%,calc(100% - 2px) 68%,calc(100% - 6px) 88%,calc(100% - 12px) 100%,0 100%); box-shadow:0 2px 8px rgba(26,26,26,0.10),inset 0 1px 0 rgba(255,255,255,0.92),inset 0 -1px 0 rgba(26,26,26,0.08);">
                    <tr>
