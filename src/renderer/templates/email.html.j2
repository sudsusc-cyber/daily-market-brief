              {% for item in judgment_section.items %}
              <div style="{% if not loop.last %}margin-bottom:14px;{% endif %}">
                <span style="color:{{ color_accent }};">「{{ item.thesis }}」</span>{{ item.tail }}
              </div>
              {% endfor %}
            </div>
            {% endif %}
            {% if buffett_13f and buffett_13f.is_new %}
            <div style="margin-top:{% if judgment_section %}36px{% else %}0{% endif %}; text-align:center; font-family:Charter,Georgia,serif; font-size:13.5px; line-height:1.9; color:{{ color_muted }}; letter-spacing:0.02em;">
              伯克希尔本季度 13F 已于 {{ buffett_13f.latest.filed_at | bj_date_cn }}披露
              <br/>
              <a href="https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&amp;CIK=0001067983&amp;type=13F-HR&amp;dateb=&amp;owner=include&amp;count=40" target="_blank" rel="noopener" style="color:#0563C1; text-decoration:none; font-size:12px; letter-spacing:0.06em; border-bottom:0.5px solid #B5D0EC; padding-bottom:1px;">前往 SEC EDGAR 查阅持仓</a>
            </div>
            {% endif %}
          </td>
        </tr>
        {% endif %}

        {# 装饰性结尾 #}
        <tr>
          <td align="center" style="padding:56px 24px 24px 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
                <td style="padding:0 14px; font-size:14px; color:{{ color_accent }}; line-height:1; font-family:{{ serif_display }};">·&nbsp;·&nbsp;·</td>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>

        {# ─────────────────────────  COLOPHON / FOOTER  ───────────────────────── #}
        <tr>
          <td align="center" style="padding:0 24px 0 24px; font-family:{{ serif_body }};">
            <div style="font-size:11.5px; color:{{ color_ink_soft }}; line-height:1.7; letter-spacing:0.06em;">
              本邮件由开源的私人晨报系统发送
            </div>
            <div style="margin-top:6px; font-family:Charter,Georgia,serif; font-size:10.5px; color:{{ color_faint }}; letter-spacing:0.18em; text-transform:uppercase;">
              刊发时间&nbsp;·&nbsp;{{ generated_at.strftime('%Y-%m-%d %H:%M') }}&nbsp;CST
            </div>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

</body>
</html>
