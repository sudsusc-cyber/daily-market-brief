{#-
  email.html.j2 — 每日晨报 HTML 邮件模板

  设计基调:Berkshire 致股东信 × FT Weekend × Howard Marks Memo
  强调色:oxblood #7A1F2B(全文唯一)
  字体:衬线为主,中英文 fallback 链覆盖 macOS / Windows / Linux

  M2 阶段渲染:masthead + I. 持仓信号 + footer
  M3 起按 {% if section %} 渐次启用其他区块

  上下文变量:
    signals       — list[StockSignal](M2 必传)
    generated_at  — datetime,北京时间
    sentiment     — dict | None       (M3 用)
    company_news  — str  | None       (M3 用)
    figures       — list | None       (M3 用)
    macro_news    — str  | None       (M3 用)

  Filter(由 renderer/render.py 注册):
    | price  →  浮点千分位 + 2 位小数
    | pct    →  浮点百分比,带正负号(如 +9.2%)
-#}
{%- set year_cn = (generated_at.year | string)
      | replace('0','〇') | replace('1','一') | replace('2','二')
      | replace('3','三') | replace('4','四') | replace('5','五')
      | replace('6','六') | replace('7','七') | replace('8','八')
      | replace('9','九') -%}
{# 月、日转汉字数字:1-31 → 一/二/三/.../十/十一/.../三十一 #}
{%- set _digit_cn = ['零','一','二','三','四','五','六','七','八','九','十'] -%}
{%- macro num_cn(n) -%}
{%- if n <= 10 -%}{{ _digit_cn[n] }}
{%- elif n < 20 -%}十{{ _digit_cn[n - 10] }}
{%- elif n % 10 == 0 -%}{{ _digit_cn[n // 10] }}十
{%- else -%}{{ _digit_cn[n // 10] }}十{{ _digit_cn[n % 10] }}
{%- endif -%}
{%- endmacro -%}
{%- set month_cn = num_cn(generated_at.month) -%}
{%- set day_cn = num_cn(generated_at.day) -%}
{%- set weekdays = ['星期一', '星期二', '星期三', '星期四', '星期五', '星期六', '星期日'] -%}
{# 思源宋体 / Source Han Serif SC 优先;退路是 macOS 自带宋体与 Windows Cambria #}
{%- set serif_display = "'Noto Serif SC','Source Han Serif SC','Songti SC','STSong','Newsreader','Source Serif Pro',Charter,Cambria,Georgia,serif" -%}
{%- set serif_body = "'Noto Serif SC','Source Han Serif SC','Songti SC','STSong',Charter,Cambria,Georgia,'Times New Roman',Times,serif" -%}
{%- set color_paper = '#F8F5EE' -%}
{%- set color_paper_alt = '#F2ECDC' -%}
{%- set color_ink = '#1A1A1A' -%}
{%- set color_ink_soft = '#2B2B2B' -%}
{%- set color_muted = '#6B6B6B' -%}
{%- set color_faint = '#A09887' -%}
{%- set color_rule = '#1A1A1A' -%}
{%- set color_hairline = '#D9D2BE' -%}
{%- set color_accent = '#7A1F2B' -%}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="x-apple-disable-message-reformatting" />
<meta name="color-scheme" content="light" />
<meta name="supported-color-schemes" content="light" />
<title>每日晨报 · {{ year_cn }}年 · {{ month_cn }}月{{ day_cn }}日</title>
<!--[if mso]>
<style type="text/css">
  table,td,div,h1,h2,p { font-family: Cambria, Georgia, serif !important; }
  table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
</style>
<![endif]-->
</head>
<body style="margin:0; padding:0; background-color:{{ color_paper }}; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">

{# 收件箱预览文字(preheader),不可见 #}
<div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:{{ color_paper }};">
  {{ year_cn }}年 · {{ month_cn }}月{{ day_cn }}日 · 持仓信号摘录 · 数据截至北京时间 {{ generated_at.strftime('%H:%M') }}
</div>
<div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:{{ color_paper }};">
  &#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{ color_paper }};">
  <tr>
    <td align="center" style="padding:{% if header_image_url %}16px{% else %}48px{% endif %} 16px 56px 16px;">

      <table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="background-color:{{ color_paper }}; max-width:640px; width:100%;">

        {# ──────────────────────────  刊头图  ─────────────────────────── #}
        {%- if header_image_url %}
        <tr>
          <td style="padding:0; line-height:0; font-size:0; border-bottom:2px solid {{ color_accent }};">
            <img src="{{ header_image_url }}"
                 width="640" height="320"
                 alt=""
                 style="display:block; width:100%; max-width:640px; height:auto; border:0; line-height:0;" />
          </td>
        </tr>
        {%- endif %}

        {# ─────────────────────────  MASTHEAD  ───────────────────────── #}
        <tr>
          <td align="center" style="padding:{% if header_image_url %}28px{% else %}0{% endif %} 24px 4px 24px; font-family:{{ serif_display }}; color:{{ color_ink }};">
            <div style="font-size:11px; letter-spacing:0.46em; color:{{ color_accent }}; text-transform:uppercase; margin-bottom:18px; font-family:{{ serif_body }};">
              Daily&nbsp;&nbsp;Brief
            </div>
            <div style="font-size:42px; line-height:1.0; font-weight:500; letter-spacing:0.32em; text-indent:0.32em; color:{{ color_ink }};">
              每日晨报
            </div>
            <div style="margin:18px auto 14px auto; height:1px; line-height:1px; font-size:0; width:48px; background-color:{{ color_accent }};">&nbsp;</div>
            <div style="font-size:13px; color:{{ color_muted }}; letter-spacing:0.10em; font-family:{{ serif_body }};">
              {{ year_cn }}年 · {{ month_cn }}月{{ day_cn }}日 · {{ weekdays[generated_at.weekday()] }}
            </div>
          </td>
        </tr>

        {# 装饰性分隔(章节起始) #}
        <tr>
          <td align="center" style="padding:36px 24px 36px 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
                <td style="padding:0 14px; font-size:14px; color:{{ color_accent }}; line-height:1; font-family:{{ serif_display }};">·&nbsp;·&nbsp;·</td>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>

        {# ─────────────────────────  I. 持仓信号  ───────────────────────── #}
        {% if signals %}
        <tr>
          <td style="padding:0 24px 0 24px;">

            {# 区段标题:无罗马数字,中文用 letter-spacing 拉字距 #}
            <div style="font-family:{{ serif_display }}; font-size:18px; font-weight:600; color:{{ color_ink }}; letter-spacing:0.4em; line-height:1.2; margin:0; padding:0;">持仓信号</div>
            <div style="font-family:Charter,Georgia,serif; font-size:11px; color:{{ color_muted }}; letter-spacing:0.3em; text-transform:uppercase; margin:8px 0 0 0;">Position Signals</div>
            <div style="border-top:1px solid {{ color_rule }}; margin-top:24px; line-height:0; font-size:0;">&nbsp;</div>

            {# 引言段:解释这个表格在看什么。M2 实用,M3 起可换成更克制的款式 #}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="padding:18px 4px 8px 4px; font-family:{{ serif_body }}; font-size:15px; line-height:1.85; color:{{ color_ink_soft }}; letter-spacing:0.02em;">
                  {%- if holdings_intro %}
                  {{ holdings_intro }}
                  {%- else %}
                  当前持仓十二只——美股十只,港股两只。下表展示各只标的现价相对 120 周与 200 周均线的位置。
                  现价跌破<span style="color:{{ color_accent }}; font-family:{{ serif_body }}; letter-spacing:0.04em; white-space:nowrap;">120 周</span>触发<span style="color:{{ color_accent }}; letter-spacing:0.16em; text-transform:uppercase; font-weight:600; white-space:nowrap;">&nbsp;DCA</span>,
                  跌破<span style="color:{{ color_accent }}; font-family:{{ serif_body }}; letter-spacing:0.04em; white-space:nowrap;">200 周</span>触发<span style="color:{{ color_accent }}; letter-spacing:0.16em; text-transform:uppercase; font-weight:600; white-space:nowrap;">&nbsp;Lump-sum</span>;
                  无信号则记录至最近均线的距离。
                  {%- endif %}
                </td>
              </tr>
            </table>

          </td>
        </tr>

        {# 数据表格 #}
        <tr>
          <td style="padding:8px 24px 8px 24px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; font-family:{{ serif_body }}; color:{{ color_ink }};">
              <thead>
                <tr>
                  {# 表头第一栏与 ticker 行结构对齐:logo 子列留空,"标 的"对齐 ticker 文字列 #}
                  <th style="padding:14px 8px 8px 0; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td valign="middle" width="36" style="padding-right:12px;">&nbsp;</td>
                        <td valign="middle" align="left" style="font-family:{{ serif_body }}; font-size:9.5px; font-weight:500; letter-spacing:0.32em; color:{{ color_muted }}; text-transform:uppercase; line-height:1;">
                          标&nbsp;的
                        </td>
                      </tr>
                    </table>
                  </th>
                  <th align="right" style="padding:14px 0 8px 0; font-family:{{ serif_body }}; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    现&nbsp;价
                  </th>
                  <th align="right" style="padding:14px 0 8px 16px; font-family:{{ serif_body }}; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    120&nbsp;周
                  </th>
                  <th align="right" style="padding:14px 0 8px 16px; font-family:{{ serif_body }}; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    200&nbsp;周
                  </th>
                  <th align="right" style="padding:14px 0 8px 16px; font-family:{{ serif_body }}; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">
                    信&nbsp;号
                  </th>
                </tr>
              </thead>
              <tbody>
                {% for s in signals %}
                {%- set is_lump = (s.signal == 'LUMP_SUM') -%}
                {%- set is_dca  = (s.signal == 'DCA') -%}
                {%- set has_error = (s.error is not none) -%}
                {%- set row_bg = color_paper_alt if is_lump else color_paper -%}
                {%- set has_logo = logo_cids and (s.holding.ticker in logo_cids) -%}
                <tr>
                  {# 标的:logo + ticker / name 横排 #}
                  <td valign="top" style="padding:16px 8px 16px 0; border-bottom:1px solid {{ color_hairline }}; background-color:{{ row_bg }};">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td valign="middle" width="36" style="padding-right:12px;">
                          {% if has_logo %}
                          <img src="cid:{{ logo_cids[s.holding.ticker] }}" width="28" height="28" alt="" style="display:block; width:28px; height:28px; border:0; outline:none; border-radius:4px;" />
                          {% else %}
                          <div style="display:block; width:28px; height:28px; line-height:28px; text-align:center; font-family:{{ serif_display }}; font-size:9px; font-weight:600; letter-spacing:0.08em; color:{{ color_paper }}; background-color:{{ color_ink }}; border-radius:4px;">{{ s.holding.ticker[:3] }}</div>
                          {% endif %}
                        </td>
                        <td valign="middle">
                          <div style="font-family:{{ serif_display }}; font-size:15px; font-weight:500; color:{{ color_ink }}; letter-spacing:0.04em; line-height:1.2;">{{ s.holding.ticker }}</div>
                          <div style="font-family:{{ serif_body }}; font-size:11px; color:{{ color_muted }}; margin-top:3px; line-height:1.3;">{{ s.holding.name }}</div>
                        </td>
                      </tr>
                    </table>
                  </td>

                  {% if has_error %}
                  {# 整行错误态:跨 4 列展示原因 #}
                  <td colspan="4" align="right" valign="middle" style="padding:18px 0; border-bottom:1px solid {{ color_hairline }}; background-color:{{ color_paper }}; font-family:{{ serif_body }}; font-size:11.5px; color:{{ color_muted }}; font-style:italic; line-height:1.5;">
                    数据获取失败 · {{ s.error }}
                  </td>
                  {% else %}
                  {# 现价 #}
                  <td valign="top" align="right" style="padding:18px 0 18px 0; border-bottom:1px solid {{ color_hairline }}; background-color:{{ row_bg }}; font-family:{{ serif_display }}; font-size:17px; font-weight:500; color:{{ color_ink }}; letter-spacing:0.01em; line-height:1.1; white-space:nowrap;">
                    {{ s.last_close | price }}
                  </td>
                  {# 120w #}
                  <td valign="top" align="right" style="padding:18px 0 18px 16px; border-bottom:1px solid {{ color_hairline }}; background-color:{{ row_bg }}; font-family:{{ serif_body }}; white-space:nowrap;">
                    <div style="font-size:13.5px; color:{{ color_ink }}; line-height:1.1; white-space:nowrap;">{{ s.sma_120 | price }}</div>
                    <div style="font-size:10.5px; color:{{ color_muted }}; margin-top:4px; line-height:1; letter-spacing:0.02em; white-space:nowrap;">{{ s.delta_120 | pct }}</div>
                  </td>
                  {# 200w #}
                  <td valign="top" align="right" style="padding:18px 0 18px 16px; border-bottom:1px solid {{ color_hairline }}; background-color:{{ row_bg }}; font-family:{{ serif_body }}; white-space:nowrap;">
                    <div style="font-size:13.5px; color:{{ color_ink }}; line-height:1.1; white-space:nowrap;">{{ s.sma_200 | price }}</div>
                    <div style="font-size:10.5px; color:{{ color_muted }}; margin-top:4px; line-height:1; letter-spacing:0.02em; white-space:nowrap;">{{ s.delta_200 | pct }}</div>
                  </td>
                  {# 信号 #}
                  <td valign="middle" align="right" style="padding:18px 0 18px 16px; border-bottom:1px solid {{ color_hairline }}; background-color:{{ row_bg }}; white-space:nowrap;">
                    {% if is_lump %}
                      <span style="display:inline-block; padding:5px 11px 5px 11px; background-color:{{ color_accent }}; color:{{ color_paper }}; font-family:{{ serif_body }}; font-size:9.5px; font-weight:600; letter-spacing:0.28em; text-transform:uppercase; line-height:1.3; mso-line-height-rule:exactly; white-space:nowrap;">Lump-sum</span>
                    {% elif is_dca %}
                      <span style="display:inline-block; font-family:{{ serif_body }}; font-size:11.5px; font-weight:600; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_accent }}; line-height:1; padding:0; border-bottom:1px solid {{ color_accent }}; padding-bottom:3px; white-space:nowrap;">DCA</span>
                    {% else %}
                      <span style="font-family:{{ serif_body }}; font-size:15px; color:{{ color_faint }}; line-height:1;">—</span>
                    {% endif %}
                  </td>
                  {% endif %}
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </td>
        </tr>

        {# 表格脚注 #}
        <tr>
          <td style="padding:14px 24px 0 24px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="font-family:{{ serif_body }}; font-size:10.5px; color:{{ color_muted }}; line-height:1.7; letter-spacing:0.02em;">
                  数据源&nbsp;Yahoo&nbsp;Finance&nbsp;周频收盘价。均线为最近 120 / 200 周收盘均价的算术平均。
                  括号内百分比表示现价相对该均线的位置——负值即现价低于均线。
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}

        {# ─────────────────────────  情绪温度计  ───────────────────────── #}
        {% if sentiment and sentiment.metrics %}
        <tr>
          <td style="padding:48px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:18px; font-weight:600; color:{{ color_ink }}; letter-spacing:0.4em; line-height:1.2; margin:0; padding:0;">情绪温度计</div>
            <div style="font-family:Charter,Georgia,serif; font-size:11px; color:{{ color_muted }}; letter-spacing:0.3em; text-transform:uppercase; margin:8px 0 0 0;">Market Mood</div>
            <div style="border-top:1px solid {{ color_rule }}; margin-top:24px;"></div>
          </td>
        </tr>
        {# M4 LLM 综合判断(若失败则只渲染下面的指标小表) #}
        {% if sentiment_verdict %}
        <tr>
          <td style="padding:24px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:18px; color:{{ color_ink }}; letter-spacing:0.06em; line-height:1.4;">
              {{ sentiment_verdict.verdict | cjk_spaced }}
            </div>
            <div style="margin-top:12px; font-family:{{ serif_body }}; font-size:16px; line-height:1.9; color:{{ color_ink }}; letter-spacing:0.02em;">
              {{ sentiment_verdict.argument | cjk_spaced }}
            </div>
          </td>
        </tr>
        {% endif %}
        <tr>
          <td style="padding:14px 24px 0 24px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; font-family:{{ serif_body }}; color:{{ color_ink }};">
              <thead>
                <tr>
                  <th align="left"  style="padding:12px 0 8px 0;  font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">指&nbsp;标</th>
                  <th align="right" style="padding:12px 0 8px 16px; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">当&nbsp;前</th>
                  <th align="right" style="padding:12px 0 8px 16px; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">前&nbsp;一&nbsp;日</th>
                  <th align="right" style="padding:12px 0 8px 16px; font-size:9.5px; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:{{ color_muted }}; border-top:1px solid {{ color_ink }}; border-bottom:1px solid {{ color_ink }};">变&nbsp;化</th>
                </tr>
              </thead>
              <tbody>
                {% for m in sentiment.metrics %}
                <tr>
                  <td valign="middle" style="padding:14px 0 14px 0; border-bottom:1px solid {{ color_hairline }};">
                    <div style="font-family:{{ serif_display }}; font-size:14px; color:{{ color_ink }}; letter-spacing:0.02em;">
                      {{ m.name }}{% if m.unit %}<span style="font-family:{{ serif_body }}; font-size:11px; color:{{ color_muted }}; margin-left:4px;">({{ m.unit }})</span>{% endif %}
                    </div>
                    {% if m.rating %}
                    <div style="margin-top:4px; font-family:{{ serif_body }}; font-size:10.5px; color:{{ color_muted }}; letter-spacing:0.04em;">{{ m.rating }}</div>
                    {% endif %}
                  </td>
                  {% if m.error %}
                  <td colspan="3" align="right" valign="middle" style="padding:14px 0; border-bottom:1px solid {{ color_hairline }}; font-family:{{ serif_body }}; font-size:11px; color:{{ color_muted }}; font-style:italic;">数据获取失败 · {{ m.error }}</td>
                  {% else %}
                  <td valign="middle" align="right" style="padding:14px 0 14px 16px; border-bottom:1px solid {{ color_hairline }}; font-family:{{ serif_display }}; font-size:16px; color:{{ color_ink }}; font-weight:500; font-variant-numeric:tabular-nums; font-feature-settings:'tnum';">{{ m.current | metric_num }}</td>
                  <td valign="middle" align="right" style="padding:14px 0 14px 16px; border-bottom:1px solid {{ color_hairline }}; font-family:{{ serif_body }}; font-size:13px; color:{{ color_muted }}; font-variant-numeric:tabular-nums; font-feature-settings:'tnum';">{{ m.prior | metric_num }}</td>
                  <td valign="middle" align="right" style="padding:14px 0 14px 16px; border-bottom:1px solid {{ color_hairline }}; font-family:{{ serif_body }}; font-size:12.5px; color:{{ color_muted }}; font-variant-numeric:tabular-nums; font-feature-settings:'tnum';">{{ m.delta | metric_delta }}</td>
                  {% endif %}
                </tr>
                {% endfor %}
              </tbody>
            </table>
            <div style="margin-top:14px; font-family:{{ serif_body }}; font-size:10.5px; color:{{ color_muted }}; line-height:1.7; letter-spacing:0.02em;">
              "前一日"取最近一个交易日前的可比值;非交易日(节假日)以最近一个交易日替代。
            </div>
          </td>
        </tr>
        {% endif %}

        {# ─────────────────────────  昨日动态  ───────────────────────── #}
        {% if company_news %}
        <tr>
          <td style="padding:48px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:18px; font-weight:600; color:{{ color_ink }}; letter-spacing:0.4em; line-height:1.2; margin:0; padding:0;">昨日动态</div>
            <div style="font-family:Charter,Georgia,serif; font-size:11px; color:{{ color_muted }}; letter-spacing:0.3em; text-transform:uppercase; margin:8px 0 0 0;">Yesterday in Holdings</div>
            <div style="border-top:1px solid {{ color_rule }}; margin-top:24px;"></div>
          </td>
        </tr>
        {% if company_news_summary and company_news_summary.summary_html %}
        {# M4 LLM 公司分行简报 + 区块下方脚注列表 #}
        <tr>
          <td style="padding:24px 24px 0 24px; font-family:{{ serif_body }}; font-size:16px; line-height:1.9; color:{{ color_ink }}; letter-spacing:0.02em;">
            {{ company_news_summary.summary_html | cjk_spaced | safe }}
          </td>
        </tr>
        {% if company_news_summary.footnotes %}
        <tr>
          <td style="padding:18px 24px 0 24px;">
            <div style="padding-top:12px; border-top:0.5px solid {{ color_hairline }}; line-height:2.0;">
              {% for f in company_news_summary.footnotes %}
              <a href="{{ f.url }}" target="_blank" rel="noopener" style="color:#0563C1; text-decoration:none; font-family:Charter,Georgia,serif; font-size:11.5px; letter-spacing:0.02em; margin-right:18px; white-space:nowrap;">[{{ f.index }}] {{ f.source }}</a>
              {% endfor %}
            </div>
          </td>
        </tr>
        {% endif %}
        {% else %}
        {% for bundle in company_news %}
        {%- set has_logo = logo_cids and (bundle.holding.ticker in logo_cids) -%}
        <tr>
          <td style="padding:18px 24px 0 24px;">
            {# 持仓小标题:logo + ticker / name 横排 #}
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td valign="middle" width="36" style="padding-right:12px;">
                  {% if has_logo %}
                  <img src="cid:{{ logo_cids[bundle.holding.ticker] }}" width="28" height="28" alt="" style="display:block; width:28px; height:28px; border:0; outline:none; border-radius:4px;" />
                  {% else %}
                  <div style="display:block; width:28px; height:28px; line-height:28px; text-align:center; font-family:{{ serif_display }}; font-size:9px; font-weight:600; letter-spacing:0.08em; color:{{ color_paper }}; background-color:{{ color_ink }}; border-radius:4px;">{{ bundle.holding.ticker[:3] }}</div>
                  {% endif %}
                </td>
                <td valign="middle">
                  <span style="font-family:{{ serif_display }}; font-size:14px; font-weight:500; color:{{ color_ink }}; letter-spacing:0.04em;">{{ bundle.holding.ticker }}</span>
                  <span style="font-family:{{ serif_body }}; font-size:11px; color:{{ color_muted }}; margin-left:8px;">{{ bundle.holding.name }}</span>
                </td>
              </tr>
            </table>
            {# 该股的新闻列表 / 错误 / 空 三态 #}
            <div style="margin-top:8px; padding-left:48px;">
              {% if bundle.error %}
              <div style="font-family:{{ serif_body }}; font-size:11.5px; color:{{ color_muted }}; font-style:italic;">数据获取失败 · {{ bundle.error }}</div>
              {% elif not bundle.items %}
              <div style="font-family:{{ serif_body }}; font-size:11.5px; color:{{ color_faint }}; font-style:italic;">昨日无重要新闻</div>
              {% else %}
              <ul style="margin:0; padding:0; list-style:none;">
                {% for item in bundle.items[:5] %}
                <li style="margin:0 0 6px 0; font-family:{{ serif_body }}; font-size:13px; line-height:1.55; color:{{ color_ink_soft }};">
                  <span style="color:{{ color_muted }}; font-size:10.5px; letter-spacing:0.04em; margin-right:8px;">{{ item.published_at | bj_time }}</span>
                  <a href="{{ item.url }}" target="_blank" rel="noopener" style="color:{{ color_ink_soft }}; text-decoration:none; border-bottom:1px solid {{ color_hairline }};">{{ item.title }}</a>
                  <span style="color:{{ color_faint }}; font-size:10.5px; margin-left:6px;">— {{ item.source }}</span>
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
        {% endif %}{# end company_news_paragraph else #}
        {% endif %}{# end company_news outer #}

        {# ─────────────────────────  关键发言  ───────────────────────── #}
        {% if figures or (buffett_13f and buffett_13f.is_new) %}
        <tr>
          <td style="padding:48px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:18px; font-weight:600; color:{{ color_ink }}; letter-spacing:0.4em; line-height:1.2; margin:0; padding:0;">关键发言</div>
            <div style="font-family:Charter,Georgia,serif; font-size:11px; color:{{ color_muted }}; letter-spacing:0.3em; text-transform:uppercase; margin:8px 0 0 0;">Voices</div>
            <div style="border-top:1px solid {{ color_rule }}; margin-top:24px;"></div>
          </td>
        </tr>
        {% if not figure_summaries %}
        {# 全员沉默:LLM 写一句古典韵味占位语,失败时退回固定兜底 #}
        <tr>
          <td style="padding:24px 24px 0 24px;">
            <div style="font-family:{{ serif_body }}; font-size:15px; line-height:1.9; color:{{ color_muted }}; letter-spacing:0.04em; font-style:italic; text-align:center;">
              {{ figure_silence_note or "群贤皆默,市自为声。" }}
            </div>
          </td>
        </tr>
        {% endif %}
        {% if figure_summaries %}
        {# M4 LLM 第二道筛选 + 关键观点提炼;每个人物即使 0 条也展示小标题 + "昨日无发言" #}
        {% for f in figure_summaries %}
        <tr>
          <td style="padding:18px 24px 0 24px;">
            {# 人物姓名作为小标题:字号 13 + 字距 + 加粗 + oxblood,与主体观点 16/1.9 区分 #}
            <div style="font-family:{{ serif_body }}; font-size:13px; color:{{ color_accent }}; letter-spacing:0.32em; font-weight:600; margin:0 0 14px 0;">{{ f.person }}</div>
            <div>
              {% if f.items %}
              <ul style="margin:0; padding:0; list-style:none;">
                {% for kp in f.items %}
                <li style="margin:0 0 10px 0; font-family:{{ serif_body }}; font-size:16px; line-height:1.9; color:{{ color_ink }}; letter-spacing:0.02em;">
                  {{ kp.text | cjk_spaced }}
                  {% if kp.source_url %}
                  <a href="{{ kp.source_url }}" target="_blank" rel="noopener" style="color:#0563C1; text-decoration:none; font-family:Charter,Georgia,serif; font-size:11.5px; letter-spacing:0.02em; margin-left:8px;">[{{ kp.source_name }}]</a>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
              {% elif f.fallback_raw %}
              {# LLM 全 no:展示原始候选,样式统一 16/1.9 #}
              <ul style="margin:0; padding:0; list-style:none;">
                {% for item in f.fallback_raw %}
                <li style="margin:0 0 10px 0; font-family:{{ serif_body }}; font-size:16px; line-height:1.9; color:{{ color_ink }}; letter-spacing:0.02em;">
                  {{ item.title | cjk_spaced }}
                  {% if item.url %}
                  <a href="{{ item.url }}" target="_blank" rel="noopener" style="color:#0563C1; text-decoration:none; font-family:Charter,Georgia,serif; font-size:11.5px; letter-spacing:0.02em; margin-left:8px;">[{{ item.source }}]</a>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
              {% else %}
              <div style="font-family:{{ serif_body }}; font-size:16px; line-height:1.9; color:{{ color_muted }}; letter-spacing:0.02em;">{{ f.error or '昨日无发言。' }}</div>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
        {% else %}
        {# 降级:展示 M3 原始候选列表 #}
        {% for f in figures %}
        <tr>
          <td style="padding:18px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:15px; color:{{ color_accent }}; letter-spacing:0.06em; font-weight:500;">{{ f.person }}</div>
            <div style="margin-top:10px;">
              {% if f.error %}
              <div style="font-family:{{ serif_body }}; font-size:11.5px; color:{{ color_muted }}; font-style:italic;">数据获取失败 · {{ f.error }}</div>
              {% elif not f.items %}
              <div style="font-family:{{ serif_body }}; font-size:11.5px; color:{{ color_faint }}; font-style:italic;">过去 24 小时无新候选发言</div>
              {% else %}
              <ul style="margin:0; padding:0; list-style:none;">
                {% for item in f.items[:5] %}
                <li style="margin:0 0 6px 0; font-family:{{ serif_body }}; font-size:13px; line-height:1.55; color:{{ color_ink_soft }};">
                  <span style="color:{{ color_muted }}; font-size:10.5px; letter-spacing:0.04em; margin-right:8px;">{{ item.published_at | bj_time }}</span>
                  <a href="{{ item.url }}" target="_blank" rel="noopener" style="color:{{ color_ink_soft }}; text-decoration:none; border-bottom:1px solid {{ color_hairline }};">{{ item.title }}</a>
                  <span style="color:{{ color_faint }}; font-size:10.5px; margin-left:6px;">— {{ item.source }}</span>
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
        {% endif %}{# end figure_summaries / figures fallback #}
        {% if buffett_13f and buffett_13f.is_new %}
        <tr>
          <td style="padding:24px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:15px; color:{{ color_accent }}; letter-spacing:0.06em; font-weight:500;">Berkshire 13F</div>
            <div style="margin-top:8px; font-family:{{ serif_body }}; font-size:13px; color:{{ color_ink_soft }}; line-height:1.6;">
              SEC EDGAR 检测到新 13F 提交(accession <span style="font-family:Charter,Cambria,serif; color:{{ color_muted }};">{{ buffett_13f.latest.accession_no }}</span>),
              提交于北京时间 {{ buffett_13f.latest.filed_at | bj_time }}{% if buffett_13f.days_since_filed is not none %},距今 {{ buffett_13f.days_since_filed }} 天{% endif %}。
              具体持仓变动(新增 / 加仓 / 减仓 / 清仓)将在 13F-HR XML 解析接入后呈现(M4+)。
            </div>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        {# ─────────────────────────  宏观视野  ───────────────────────── #}
        {% if macro_news %}
        <tr>
          <td style="padding:48px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:18px; font-weight:600; color:{{ color_ink }}; letter-spacing:0.4em; line-height:1.2; margin:0; padding:0;">宏观视野</div>
            <div style="font-family:Charter,Georgia,serif; font-size:11px; color:{{ color_muted }}; letter-spacing:0.3em; text-transform:uppercase; margin:8px 0 0 0;">Macro Horizon</div>
            <div style="border-top:1px solid {{ color_rule }}; margin-top:24px;"></div>
          </td>
        </tr>
        {% if macro_news_summary and macro_news_summary.summary_html %}
        {# M4 LLM 主题分段叙述 + 区块下方脚注 #}
        <tr>
          <td style="padding:24px 24px 0 24px; font-family:{{ serif_body }}; font-size:16px; line-height:1.9; color:{{ color_ink }}; letter-spacing:0.02em;">
            {{ macro_news_summary.summary_html | cjk_spaced | safe }}
          </td>
        </tr>
        {% if macro_news_summary.footnotes %}
        <tr>
          <td style="padding:8px 24px 0 24px;">
            <div style="padding-top:12px; border-top:0.5px solid {{ color_hairline }}; line-height:2.0;">
              {% for f in macro_news_summary.footnotes %}
              <a href="{{ f.url }}" target="_blank" rel="noopener" style="color:#0563C1; text-decoration:none; font-family:Charter,Georgia,serif; font-size:11.5px; letter-spacing:0.02em; margin-right:18px; white-space:nowrap;">[{{ f.index }}] {{ f.source }}</a>
              {% endfor %}
            </div>
          </td>
        </tr>
        {% endif %}
        {% else %}
        {% for bundle in macro_news %}
        <tr>
          <td style="padding:18px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:15px; color:{{ color_accent }}; letter-spacing:0.06em; font-weight:500;">{{ bundle.source }}</div>
            <div style="margin-top:10px;">
              {% if bundle.error %}
              <div style="font-family:{{ serif_body }}; font-size:11.5px; color:{{ color_muted }}; font-style:italic;">数据获取失败 · {{ bundle.error }}</div>
              {% elif not bundle.items %}
              <div style="font-family:{{ serif_body }}; font-size:11.5px; color:{{ color_faint }}; font-style:italic;">过去 24 小时无条目</div>
              {% else %}
              <ul style="margin:0; padding:0; list-style:none;">
                {% for item in bundle.items[:5] %}
                <li style="margin:0 0 6px 0; font-family:{{ serif_body }}; font-size:13px; line-height:1.55; color:{{ color_ink_soft }};">
                  <span style="color:{{ color_muted }}; font-size:10.5px; letter-spacing:0.04em; margin-right:8px;">{{ item.published_at | bj_time }}</span>
                  <a href="{{ item.url }}" target="_blank" rel="noopener" style="color:{{ color_ink_soft }}; text-decoration:none; border-bottom:1px solid {{ color_hairline }};">{{ item.title }}</a>
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
        {% endif %}{# end macro_news_paragraph else #}
        {% endif %}{# end macro_news outer #}

        {# 装饰性结尾 #}
        <tr>
          <td align="center" style="padding:56px 24px 24px 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
                <td style="padding:0 14px; font-size:14px; color:{{ color_accent }}; line-height:1; font-family:{{ serif_display }};">·&nbsp;·&nbsp;·</td>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>

        {# ─────────────────────────  COLOPHON / FOOTER  ───────────────────────── #}
        <tr>
          <td align="center" style="padding:0 24px 0 24px; font-family:{{ serif_body }};">
            <div style="font-size:11.5px; color:{{ color_ink_soft }}; line-height:1.7; letter-spacing:0.06em;">
              本邮件由开源的私人晨报系统发送
            </div>
            <div style="margin-top:6px; font-size:10.5px; color:{{ color_faint }}; letter-spacing:0.04em;">
              数据截至北京时间 {{ generated_at.strftime('%Y-%m-%d %H:%M') }}
            </div>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

</body>
</html>
