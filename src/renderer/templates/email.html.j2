        {% endfor %}
        {# 章节底部统一脚注列表:维持原蓝色超链接,与全文其它脚注一致 #}
        {% if figure_footnotes %}
        <tr data-source-list="true">
          <td style="padding:8px 24px 0 24px;">
            <div style="padding-top:12px; border-top:0.5px solid {{ color_hairline }}; line-height:2.0;">
              {% for fn in figure_footnotes %}
              <a class="source-link" href="{{ fn.url | safe_url }}" target="_blank" rel="noopener" style="color:#0563C1!important; text-decoration:none!important; font-family:{{ serif_body }}; font-size:11.5px; letter-spacing:0.02em; margin-right:18px; white-space:normal; overflow-wrap:anywhere; word-break:break-word;">[{{ fn.index }}] {{ fn.source }}</a>
              {% endfor %}
            </div>
          </td>
        </tr>
        {% endif %}
        {% endif %}{# end figure_summaries — M3 fallback 已删除,质量门槛优先 #}
        {% endif %}

        {# ─────────────────────────  宏观视野  ───────────────────────── #}
        {% if macro_news_summary or macro_news_silence_note or macro_news_fallback_note %}
        <tr>
          <td style="padding:48px 24px 0 24px;">
            <div style="font-family:{{ serif_display }}; font-size:18px; font-weight:600; color:{{ color_ink }}; letter-spacing:0.4em; line-height:1.2; margin:0; padding:0;">宏观视野</div>
            <div style="font-family:{{ serif_body }}; font-size:11px; color:{{ color_muted }}; letter-spacing:0.3em; text-transform:uppercase; margin:8px 0 0 0;">Macro Horizon</div>
            <div style="border-top:1px solid {{ color_rule }}; margin-top:24px;"></div>
          </td>
        </tr>
        {% if macro_news_fallback_note %}
        {# 宏观加工/数据源失败:质量门槛优先，不展示未加工 RSS 标题 #}
        <tr>
          <td style="padding:24px 24px 0 24px;">
            <div style="font-family:{{ serif_body }}; font-size:14px; line-height:1.9; color:{{ color_muted }}; letter-spacing:0.04em; font-style:italic; text-align:center;">
              {{ macro_news_fallback_note }}
            </div>
          </td>
        </tr>
        {% elif macro_news_silence_note %}
        {# 无宏观新闻:LLM 写一句古典韵味占位语,失败时退回固定兜底 #}
        <tr>
          <td style="padding:24px 24px 0 24px;">
            <div style="font-family:{{ serif_body }}; font-size:15px; line-height:1.9; color:{{ color_muted }}; letter-spacing:0.04em; font-style:italic; text-align:center;">
              {{ macro_news_silence_note or "四海无波,日升月落而已。" }}
            </div>
          </td>
        </tr>
        {% elif macro_news_summary and macro_news_summary.summary_html %}
        {# M4 LLM 主题分段叙述 + 区块下方脚注。
           summary_html 由 src/processors/macro_filter.py 经
           src/processors/html_safe.py 净化(LLM/外部文本一律 escape,
           URL 走 http(s) 白名单,只允许 p/span/sup/a 受控标签)
           → 这里 `| safe` 才是安全的。 #}
        <tr>
          <td style="padding:24px 24px 0 24px; font-family:{{ serif_body }}; font-size:16px; line-height:1.9; color:{{ color_ink }}; letter-spacing:0.02em;">
            {{ macro_news_summary.summary_html | cjk_spaced | safe }}
          </td>
        </tr>
        {% if macro_news_summary.footnotes %}
        <tr data-source-list="true">
          <td style="padding:8px 24px 0 24px;">
            <div style="padding-top:12px; border-top:0.5px solid {{ color_hairline }}; line-height:2.0;">
              {% for f in macro_news_summary.footnotes %}
              <a class="source-link" href="{{ f.url | safe_url }}" target="_blank" rel="noopener" style="color:#0563C1!important; text-decoration:none!important; font-family:{{ serif_body }}; font-size:11.5px; letter-spacing:0.02em; margin-right:18px; white-space:normal; overflow-wrap:anywhere; word-break:break-word;">[{{ f.index }}] {{ f.source }}</a>
              {% endfor %}
            </div>
          </td>
        </tr>
        {% endif %}
        {% endif %}{# end quality fallback / silence / summary #}
        {% endif %}{# end macro_news outer #}

        {% if judgment_section or (buffett_13f and buffett_13f.is_new) or jiangsu_fuel_alert %}
        <tr>
          <td style="padding:48px 24px 0 24px;">
            {# ❀ 横线 ornament — table-based 以兼容 Outlook(避免 flex/grid,符合 CLAUDE.md 邮件约束) #}
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:36px; border-collapse:collapse;">
              <tr>
                <td width="50%" style="border-bottom:1px solid {{ color_hairline }}; line-height:1px; font-size:0; height:8px;">&nbsp;</td>
                <td rowspan="2" style="padding:0 18px; font-family:'Apple Color Emoji','Segoe UI Symbol','Noto Sans Symbols','Songti SC','STSong',serif; font-size:14px; line-height:1; color:#a89c83; white-space:nowrap; vertical-align:middle;">❀</td>
                <td width="50%" style="border-bottom:1px solid {{ color_hairline }}; line-height:1px; font-size:0; height:8px;">&nbsp;</td>
              </tr>
              <tr>
                <td style="line-height:1px; font-size:0; height:7px;">&nbsp;</td>
                <td style="line-height:1px; font-size:0; height:7px;">&nbsp;</td>
              </tr>
            </table>
            {% if judgment_section %}
            <div style="font-size:15px; line-height:2; color:{{ color_ink }}; text-align:center;">
              {% for item in judgment_section.items %}
              <div style="{% if not loop.last %}margin-bottom:14px;{% endif %}">
                <span style="color:{{ color_accent }};">「{{ item.thesis }}」</span>{% if item.marker %}<span data-judgment-marker="true" style="font-family:{{ serif_body }}; font-size:11.5px; color:{{ color_muted }}; letter-spacing:0.08em; white-space:nowrap;">&nbsp;&nbsp;{{ item.marker }}</span>{% endif %}
              </div>
              {% endfor %}
            </div>
            {% endif %}
            {% if buffett_13f and buffett_13f.is_new %}
            <div style="margin-top:{% if judgment_section %}36px{% else %}0{% endif %}; text-align:center; font-family:{{ serif_body }}; font-size:13.5px; line-height:1.9; color:{{ color_muted }}; letter-spacing:0.02em;">
              伯克希尔本季度 13F 已于 {{ buffett_13f.latest.filed_at | bj_date_cn }}披露
              <br/>
              <a href="https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&amp;CIK=0001067983&amp;type=13F-HR&amp;dateb=&amp;owner=include&amp;count=40" target="_blank" rel="noopener" style="color:#0563C1; text-decoration:none; font-size:12px; letter-spacing:0.06em; border-bottom:0.5px solid #B5D0EC; padding-bottom:1px;">前往 SEC EDGAR 查阅持仓</a>
            </div>
            {% endif %}
            {% if jiangsu_fuel_alert %}
            <div style="margin-top:{% if judgment_section or (buffett_13f and buffett_13f.is_new) %}36px{% else %}0{% endif %}; text-align:center; font-family:{{ serif_body }}; font-size:13.5px; line-height:1.9; color:{{ color_muted }}; letter-spacing:0.02em;">
              <span style="color:{{ color_accent }}; letter-spacing:0.08em;">油价预告</span>
              <br/>
              预计 {{ jiangsu_fuel_alert.adjustment_date.month }} 月 {{ jiangsu_fuel_alert.adjustment_date.day }} 日 24 时{% if jiangsu_fuel_alert.direction == "待定" %}开启调价窗口{% else %}{{ jiangsu_fuel_alert.direction | e }}{% endif %}
              <br/>
              <span style="font-size:12.5px; color:{{ color_ink_soft }};">{{ jiangsu_fuel_alert.detail | e }}</span>
            </div>
            {% endif %}
          </td>
        </tr>
        {% endif %}

        {# 装饰性结尾 #}
        <tr>
          <td align="center" style="padding:56px 24px 24px 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
                <td style="padding:0 14px; font-size:14px; color:{{ color_accent }}; line-height:1; font-family:{{ serif_display }};">·&nbsp;·&nbsp;·</td>
                <td style="border-top:1px solid {{ color_rule }}; width:96px; line-height:1px; font-size:0;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>

        {# ─────────────────────────  COLOPHON / FOOTER  ───────────────────────── #}
        <tr>
          <td align="center" style="padding:0 24px 0 24px; font-family:{{ serif_body }};">
            <div style="font-size:11.5px; color:{{ color_ink_soft }}; line-height:1.7; letter-spacing:0.06em;">
              本邮件由开源的私人晨报系统发送
            </div>
            <div style="margin-top:6px; font-family:{{ serif_body }}; font-size:10.5px; color:{{ color_faint }}; letter-spacing:0.18em; text-transform:uppercase;">
              刊发时间&nbsp;·&nbsp;<span style="letter-spacing:0.04em; white-space:nowrap;">{{ generated_at.strftime('%Y-%m-%d %H:%M') }}&nbsp;UTC+8</span>
            </div>
          </td>
        </tr>

      </table>
      <!--[if mso]>
      </td></tr></table>
      <![endif]-->
    </td>
  </tr>
</table>

</body>
</html>
