# ====== Daily Market Brief 环境变量样例 ======
#
# 1) 本地调试:复制本文件为 .env,填入真实值
# 2) 生产环境(GitHub Actions):同名值配置在 GitHub Secrets,不读 .env
# 3) .env 已被 .gitignore 排除,真实文件不会入库
#
# 各 Secret 的获取方式见 PLAN.md 第 6 节
# =============================================

# DeepSeek V4-Flash API
# 来源:platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=
# 经验收后的固定版本;不会在生产运行时自动跟随新 Flash
DEEPSEEK_MODEL=deepseek-v4-flash

# Finnhub 公司新闻 API
# 来源:finnhub.io 注册后的免费 API Key
FINNHUB_API_KEY=

# FRED 宏观指标(高收益债利差等)
# 来源:fred.stlouisfed.org 注册免费 API Key
FRED_API_KEY=

# QQ 邮箱 SMTP 配置
# QQ_EMAIL_AUTH_CODE 是 QQ 邮箱的"授权码",不是 QQ 登录密码
# 获取:QQ 邮箱网页版 → 设置 → 账户 → 开启 IMAP/SMTP 并生成授权码
QQ_EMAIL_ADDRESS=
QQ_EMAIL_AUTH_CODE=

# 邮件接收方;逗号分隔可填多个(如同时发 QQ + Gmail)
# 示例:EMAIL_RECIPIENT=me@qq.com,me@gmail.com
EMAIL_RECIPIENT=
